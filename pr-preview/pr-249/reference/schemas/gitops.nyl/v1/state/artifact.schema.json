{
  "$defs": {
    "ArtifactMetadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/ArtifactUnit"
        }
      },
      "required": [
        "name",
        "unit"
      ],
      "type": "object"
    },
    "ArtifactUnit": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "$ref": "#/$defs/EnvironmentName"
        },
        "name": {
          "$ref": "#/$defs/UnitName"
        },
        "uid": {
          "$ref": "#/$defs/Uid"
        }
      },
      "required": [
        "environment",
        "name",
        "uid"
      ],
      "type": "object"
    },
    "EnvironmentName": {
      "description": "An Environment's name, unique across declared Environments and all\ntemplate instances because leases, run refs, and keep refs are named\nafter it. A Kubernetes DNS label.",
      "type": "string"
    },
    "ExecutionKey": {
      "description": "A digest of everything that decides what a unit's execution does:\n`sha256:` and 64 lowercase hex digits.",
      "type": "string"
    },
    "Uid": {
      "description": "The UUIDv7 of one incarnation of a unit. It fences every receipt,\ncheckpoint, and deletion.",
      "type": "string"
    },
    "UnitName": {
      "description": "A unit's literal `metadata.name`, unique per environment across all\nunit kinds. A Kubernetes DNS label.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An artifact document, under `observed/units/<unit>/artifacts/<name>.yaml`.",
  "properties": {
    "apiVersion": {
      "description": "The artifact kind's group, such as `artifacts.gitops.nyl/v1`.",
      "type": "string"
    },
    "executionKey": {
      "$ref": "#/$defs/ExecutionKey"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ArtifactMetadata"
    },
    "spec": true
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "executionKey",
    "spec"
  ],
  "title": "Artifact",
  "type": "object"
}
