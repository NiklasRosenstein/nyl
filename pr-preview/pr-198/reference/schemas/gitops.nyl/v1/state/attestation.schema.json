{
  "$defs": {
    "ArtifactUnit": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "$ref": "#/$defs/EnvironmentName"
        },
        "name": {
          "$ref": "#/$defs/UnitName"
        },
        "uid": {
          "$ref": "#/$defs/Uid"
        }
      },
      "required": [
        "environment",
        "name",
        "uid"
      ],
      "type": "object"
    },
    "AttestationKind": {
      "const": "Attestation"
    },
    "AttestationResult": {
      "enum": [
        "pass",
        "fail"
      ],
      "type": "string"
    },
    "EnvironmentName": {
      "description": "An Environment's name, unique across declared Environments and all\ntemplate instances because leases, run refs, and keep refs are named\nafter it. A Kubernetes DNS label.",
      "type": "string"
    },
    "StateV1": {
      "const": "gitops.nyl/v1"
    },
    "Uid": {
      "description": "The UUIDv7 of one incarnation of a unit. It fences every receipt,\ncheckpoint, and deletion.",
      "type": "string"
    },
    "UnitName": {
      "description": "A unit's literal `metadata.name`, unique per environment across all\nunit kinds. A Kubernetes DNS label.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An attestation of a receipt, or of an environment's state.",
  "properties": {
    "apiVersion": {
      "$ref": "#/$defs/StateV1"
    },
    "at": {
      "format": "date-time",
      "type": "string"
    },
    "details": true,
    "executionKey": {
      "description": "The receipt attested; environment-wide, the desired commit of the state.",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/AttestationKind"
    },
    "name": {
      "type": "string"
    },
    "reason": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "$ref": "#/$defs/AttestationResult"
    },
    "source": true,
    "unit": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactUnit"
        },
        {
          "type": "null"
        }
      ],
      "description": "Absent for an environment-wide attestation."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "name",
    "executionKey",
    "result",
    "at",
    "source"
  ],
  "title": "Attestation",
  "type": "object"
}
