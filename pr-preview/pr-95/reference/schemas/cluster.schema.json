{
  "$defs": {
    "ClusterDestination": {
      "additionalProperties": false,
      "description": "Argo CD's identity for a concrete cluster.",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "server": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ClusterKubernetesCapabilities": {
      "additionalProperties": false,
      "description": "Kubernetes discovery information used for deterministic offline rendering.",
      "properties": {
        "apiVersions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kubeVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ClusterLiveConfiguration": {
      "additionalProperties": false,
      "description": "Local-only connection settings for live operations against a cluster.",
      "properties": {
        "context": {
          "type": "string"
        }
      },
      "required": [
        "context"
      ],
      "type": "object"
    },
    "ClusterSpec": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "$ref": "#/$defs/ClusterDestination"
        },
        "kubernetes": {
          "$ref": "#/$defs/ClusterKubernetesCapabilities"
        },
        "live": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClusterLiveConfiguration"
            },
            {
              "type": "null"
            }
          ]
        },
        "values": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "destination",
        "kubernetes"
      ],
      "type": "object"
    },
    "GitOpsResourceMetadata": {
      "additionalProperties": false,
      "description": "Metadata shared by local GitOps compiler resources.",
      "properties": {
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A concrete Kubernetes cluster and the deterministic facts used to render for it.",
  "properties": {
    "apiVersion": {
      "const": "gitops.nyl.niklasrosenstein.github.com/v1",
      "type": "string"
    },
    "kind": {
      "const": "Cluster",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/GitOpsResourceMetadata"
    },
    "spec": {
      "$ref": "#/$defs/ClusterSpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "Cluster",
  "type": "object"
}
