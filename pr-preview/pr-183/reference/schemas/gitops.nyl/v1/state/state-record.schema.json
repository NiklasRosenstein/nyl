{
  "$defs": {
    "CommitId": {
      "description": "A full, lowercase, 40-character Git commit ID.",
      "type": "string"
    },
    "EnvironmentName": {
      "description": "An Environment's name, unique across declared Environments and all\ntemplate instances because leases, run refs, and keep refs are named\nafter it. A Kubernetes DNS label.",
      "type": "string"
    },
    "StateEvent": {
      "description": "One initialization, move, or restore of a state location.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "at": {
              "format": "date-time",
              "type": "string"
            },
            "by": {
              "type": "string"
            },
            "fresh": {
              "description": "A deliberate fresh start: every unit is a new incarnation.",
              "type": "boolean"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "state-initialized",
              "type": "string"
            }
          },
          "required": [
            "type",
            "at",
            "by"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "at": {
              "format": "date-time",
              "type": "string"
            },
            "by": {
              "type": "string"
            },
            "from": {
              "$ref": "#/$defs/StateLocation",
              "description": "The location the state moved from."
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "to": {
              "$ref": "#/$defs/StateLocation",
              "description": "The location the state moved to."
            },
            "type": {
              "const": "state-moved",
              "type": "string"
            }
          },
          "required": [
            "type",
            "at",
            "by",
            "from",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "at": {
              "format": "date-time",
              "type": "string"
            },
            "by": {
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "to": {
              "$ref": "#/$defs/CommitId",
              "description": "The commit whose content was restored."
            },
            "type": {
              "const": "state-restored",
              "type": "string"
            }
          },
          "required": [
            "type",
            "at",
            "by",
            "to"
          ],
          "type": "object"
        }
      ]
    },
    "StateLocation": {
      "additionalProperties": false,
      "description": "Where an environment's state lives, as `state.yaml` records it.",
      "properties": {
        "coordinationRefPrefix": {
          "type": "string"
        },
        "desiredRef": {
          "type": "string"
        },
        "observedRef": {
          "type": "string"
        },
        "path": {
          "description": "Directory of this environment's state within its refs; empty for the root.",
          "type": "string"
        },
        "repository": {
          "description": "Credential-free URL of the state repository, or `local` for the clone's own branches.",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "desiredRef",
        "observedRef",
        "coordinationRefPrefix"
      ],
      "type": "object"
    },
    "StateRecordKind": {
      "const": "StateRecord"
    },
    "StateV1": {
      "const": "gitops.nyl/v1"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`state.yaml`: the state location and its history.",
  "properties": {
    "apiVersion": {
      "$ref": "#/$defs/StateV1"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentName"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/StateEvent"
      },
      "type": "array"
    },
    "expiresAt": {
      "description": "An instance's expiry.",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "$ref": "#/$defs/StateRecordKind"
    },
    "location": {
      "$ref": "#/$defs/StateLocation"
    },
    "params": {
      "additionalProperties": true,
      "description": "An instance's parameters.",
      "type": "object"
    },
    "template": {
      "description": "The EnvironmentTemplate of an instance.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "environment",
    "location"
  ],
  "title": "StateRecord",
  "type": "object"
}
