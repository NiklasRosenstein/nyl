{
  "$defs": {
    "ReleaseArgoCdSpec": {
      "additionalProperties": false,
      "description": "ArgoCD-specific options for Release.",
      "properties": {
        "applicationOverride": {
          "additionalProperties": true,
          "description": "Optional partial ArgoCD Application override.\n\nMust be an object if provided.",
          "type": [
            "object",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ReleaseMetadata": {
      "additionalProperties": false,
      "description": "Metadata for Release",
      "properties": {
        "name": {
          "description": "Release name",
          "type": "string"
        },
        "namespace": {
          "description": "Target namespace for the release",
          "type": "string"
        }
      },
      "required": [
        "name",
        "namespace"
      ],
      "type": "object"
    },
    "ReleaseSpec": {
      "additionalProperties": false,
      "description": "Rendering and GitOps options for a Release.",
      "properties": {
        "additionalNamespaces": {
          "description": "Additional namespaces that rendered resources may explicitly target.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "argocd": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseArgoCdSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "ArgoCD-specific options."
        },
        "include": {
          "description": "Additional manifest files, resolved relative to the Release file.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stripEmptyMetadataLabels": {
          "anyOf": [
            {
              "$ref": "#/$defs/StripEmptyMetadataLabelsMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "Control when empty `metadata.labels` maps are stripped from emitted manifests."
        }
      },
      "type": "object"
    },
    "StripEmptyMetadataLabelsMode": {
      "description": "Controls when empty `metadata.labels` maps are stripped from emitted manifests.",
      "oneOf": [
        {
          "const": "always",
          "description": "Always strip empty `metadata.labels` maps from emitted manifests.",
          "type": "string"
        },
        {
          "const": "never",
          "description": "Never strip empty `metadata.labels` maps from emitted manifests.",
          "type": "string"
        },
        {
          "const": "argocd",
          "description": "Strip empty `metadata.labels` maps only when running in an ArgoCD environment.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Release resource for specifying release metadata",
  "properties": {
    "apiVersion": {
      "const": "gitops.nyl/v1",
      "type": "string"
    },
    "kind": {
      "const": "Release",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ReleaseMetadata"
    },
    "spec": {
      "$ref": "#/$defs/ReleaseSpec",
      "default": {}
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata"
  ],
  "title": "Release",
  "type": "object"
}
