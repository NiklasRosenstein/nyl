---
// The four layers as a vertical pipeline at the top of a layer's sidebar: the
// current layer is filled, the others are outlined, and a layer in
// development or planned takes the color of its status. Pages outside the
// layers (Get started, Reference) show no rail.
import { layerNumber, layerOf, layers } from '../lib/layers.mjs';

const { topics } = Astro.locals.starlightSidebarTopics;
const current = layerOf(topics.find((topic) => topic.isCurrent)?.link ?? '');
const links = Object.fromEntries(
  topics.flatMap((topic) => {
    const layer = layerOf(topic.link);
    return layer ? [[layer.id, topic.link]] : [];
  }),
);
---

{
  current && (
    <nav class="rail" aria-label="Layers">
      <div class="label">LAYERS</div>
      <ol>
        {layers.map((layer) => (
          <li data-tone={layer.tone} data-current={layer === current ? '' : undefined}>
            <a href={links[layer.id]} aria-current={layer === current ? 'page' : undefined}>
              <span class="node" aria-hidden="true">
                {layerNumber(layer)}
              </span>
              {layer.name}
            </a>
          </li>
        ))}
      </ol>
      <div class="label after">IN THIS LAYER</div>
    </nav>
  )
}

<style>
  .rail {
    display: none;
  }

  @media (min-width: 50rem) {
    .rail {
      display: block;
      margin-bottom: 0.75rem;
    }
  }

  .label {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.875rem;
  }

  .label.after {
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  /* The rail the nodes hang on. */
  ol::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 12px;
    bottom: 12px;
    border-left: 2px solid var(--sl-color-gray-5);
  }

  li {
    --tone: var(--nyl-layer-teal);
    position: relative;
  }

  li[data-tone='amber'] {
    --tone: var(--nyl-layer-amber);
  }

  li[data-tone='grey'] {
    --tone: var(--nyl-layer-grey);
  }

  a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.375rem 0;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: var(--sl-text-sm);
  }

  a:hover {
    color: var(--sl-color-white);
  }

  a[aria-current='page'] {
    color: var(--sl-color-white) !important;
    font-weight: 600;
    background: none !important;
  }

  .node {
    flex: 0 0 24px;
    width: 24px;
    height: 24px;
    box-sizing: border-box;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    background: var(--sl-color-bg);
    color: var(--tone);
    border: 2px solid var(--tone);
  }

  li[data-tone='grey'] .node {
    border-style: dashed;
  }

  li[data-current] .node {
    background: var(--tone);
    color: var(--sl-color-black);
  }
</style>
