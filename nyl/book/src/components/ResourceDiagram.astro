---
// How the resources of one reference section relate, drawn from the fields
// that connect them. Each box links to its resource reference.
import { resources } from '../lib/resources.mjs';

interface Props {
  section: 'kubernetes' | 'rendered-gitops' | 'orchestration';
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (name: string) => {
  const resource = resources.find((candidate) => candidate.name === name);
  return resource ? `${base}${resource.route}` : undefined;
};

const W = 180;
const H = 44;
type Node = { label: string; x: number; y: number; w?: number; h?: number; link?: boolean; note?: string };
type Edge = { from: [number, number]; to: [number, number]; label: string; at?: [number, number]; anchor?: string };

// Rendered GitOps: configuration resources and the fields that reference others.
const gitops: Node[] = [
  { label: 'ArgoCDInstance', x: 40, y: 30, link: true },
  { label: 'DeploymentTarget', x: 300, y: 30, link: true },
  { label: 'GitRepository', x: 560, y: 30, link: true },
  { label: 'Cluster', x: 40, y: 190, link: true },
  { label: 'ApplicationGroup', x: 300, y: 190, link: true },
  { label: 'AppProjectDefinition', x: 560, y: 190, link: true },
  { label: 'Release', x: 300, y: 330, link: true },
];
const gitopsEdges: Edge[] = [
  { from: [300, 52], to: [222, 52], label: 'argocdRef', at: [261, 44], anchor: 'middle' },
  { from: [480, 52], to: [558, 52], label: 'publication', at: [519, 44], anchor: 'middle' },
  { from: [130, 74], to: [130, 188], label: 'clusterRef', at: [122, 135], anchor: 'end' },
  { from: [330, 74], to: [214, 188], label: 'clusterRef', at: [256, 142], anchor: 'end' },
  { from: [390, 74], to: [390, 188], label: 'selects by labels', at: [398, 135], anchor: 'start' },
  { from: [480, 212], to: [558, 212], label: 'projectRef', at: [519, 204], anchor: 'middle' },
  { from: [460, 190], to: [600, 76], label: 'source (remote)', at: [556, 102], anchor: 'end' },
  { from: [690, 190], to: [690, 76], label: 'sourceRepositoryRefs', at: [682, 135], anchor: 'end' },
  { from: [390, 234], to: [390, 328], label: 'source directory holds', at: [398, 285], anchor: 'start' },
];

// Kubernetes rendering: what a manifest file contains and what each kind becomes.
const rendering: Node[] = [
  { label: 'Release', note: 'or a nyl render input', x: 20, y: 20, h: 284, link: true },
  { label: 'Component', x: 280, y: 20, link: true },
  { label: 'HelmChart', x: 280, y: 100, link: true },
  { label: 'RemoteManifest', x: 280, y: 180, link: true },
  { label: 'Kubernetes resources', x: 280, y: 260 },
  { label: 'Plain Kubernetes', note: 'manifests', x: 600, y: 20, h: 284 },
];
const rows = [42, 122, 202, 282];
const outputs = ['renders its local chart', 'renders the chart', 'fetches the documents', 'kept as written'];
const renderingEdges: Edge[] = [
  ...rows.map((y, index): Edge => ({
    from: [200, y],
    to: [278, y],
    label: index === 0 ? 'contains' : '',
    at: [239, y - 8],
  })),
  ...rows.map((y, index): Edge => ({ from: [460, y], to: [598, y], label: outputs[index], at: [529, y - 8] })),
];

// Orchestration: environments, their shared defaults, and where state lives.
const orchestration: Node[] = [
  { label: 'EnvironmentGroup', x: 40, y: 30, link: true },
  { label: 'Environment', x: 40, y: 170, link: true },
  { label: 'GitRepository', x: 400, y: 100, link: true },
];
const orchestrationEdges: Edge[] = [
  { from: [130, 74], to: [130, 168], label: 'selects by labels', at: [138, 125], anchor: 'start' },
  { from: [220, 52], to: [398, 114], label: 'default state repository', at: [300, 70], anchor: 'start' },
  { from: [220, 192], to: [398, 130], label: 'state.repositoryRef', at: [300, 182], anchor: 'start' },
];

const diagrams = [
  {
    id: 'rendered-gitops',
    nodes: gitops,
    edges: gitopsEdges,
    viewBox: '0 0 760 390',
    claim:
      'A DeploymentTarget binds a Cluster, an optional ArgoCDInstance, and a publication GitRepository, and selects ApplicationGroups by label. Each ApplicationGroup reads Releases from its source directory and may share an AppProjectDefinition.',
  },
  {
    id: 'kubernetes',
    nodes: rendering,
    edges: renderingEdges,
    viewBox: '0 0 790 320',
    claim:
      'A Release, or any file passed to nyl render, contains Components, HelmCharts, RemoteManifests, and plain Kubernetes resources; rendering turns each into plain Kubernetes manifests.',
  },
  {
    id: 'orchestration',
    nodes: orchestration,
    edges: orchestrationEdges,
    viewBox: '0 0 620 240',
    claim:
      'An EnvironmentGroup gives the Environments it selects shared defaults, including the repository their state lives in; an Environment may name its own.',
  },
];
const diagram = diagrams.find((candidate) => candidate.id === Astro.props.section);
---

{diagram && (
  <figure class="resource-diagram">
    <svg viewBox={diagram.viewBox} role="img" aria-label={diagram.claim}>
      <defs>
        <marker id={`arrow-${diagram.id}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
        </marker>
      </defs>
      {diagram.edges.map((edge) => (
        <g class="edge">
          <line x1={edge.from[0]} y1={edge.from[1]} x2={edge.to[0]} y2={edge.to[1]} marker-end={`url(#arrow-${diagram.id})`} />
          {edge.label && edge.at && (
            <text x={edge.at[0]} y={edge.at[1]} text-anchor={edge.anchor ?? 'middle'}>{edge.label}</text>
          )}
        </g>
      ))}
      {diagram.nodes.map((node) => {
        const w = node.w ?? W;
        const h = node.h ?? H;
        const href = node.link ? route(node.label) : undefined;
        const box = (
          <g class:list={['node', { linked: href }]}>
            <rect x={node.x} y={node.y} width={w} height={h} rx="6" />
            <text x={node.x + w / 2} y={node.y + (node.note ? h / 2 - 3 : h / 2 + 5)} text-anchor="middle">{node.label}</text>
            {node.note && <text x={node.x + w / 2} y={node.y + h / 2 + 15} text-anchor="middle">{node.note}</text>}
          </g>
        );
        return href ? <a href={href}>{box}</a> : box;
      })}
    </svg>
    <figcaption>{diagram.claim}</figcaption>
  </figure>
)}

<style>
  .resource-diagram {
    margin: 0;
    /* Narrow screens scroll the drawing instead of shrinking its text. */
    overflow-x: auto;
  }
  .resource-diagram svg {
    display: block;
    width: 100%;
    min-width: 36rem;
    height: auto;
    color: var(--sl-color-gray-2);
  }
  .edge line {
    stroke: currentColor;
    stroke-width: 1.25;
  }
  .edge text {
    fill: var(--sl-color-gray-3);
    font-size: 12px;
  }
  .node rect {
    fill: var(--sl-color-bg);
    stroke: currentColor;
    stroke-width: 1.25;
  }
  .node text {
    fill: var(--sl-color-white);
    font-size: 14px;
    font-weight: 600;
  }
  .node.linked rect {
    stroke: var(--sl-color-accent);
    stroke-width: 1.5;
  }
  .node.linked:hover rect {
    fill: var(--sl-color-accent-low);
  }
  figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
