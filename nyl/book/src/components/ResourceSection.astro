---
// A reference section's overview: how its resources relate, then each
// resource's purpose by API version.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ResourceDiagram from './ResourceDiagram.astro';
import { createResourceMarkdownProcessor } from '../lib/resource-markdown.mjs';
import { resourceGroups, resourceSections, summary } from '../lib/resources.mjs';
import { schemaFor } from '../lib/schema-documents';

interface Props {
  section: 'kubernetes-rendering' | 'kubernetes-gitops' | 'orchestration';
  description: string;
}
const { section: id, description } = Astro.props;
const section = resourceSections.find((candidate) => candidate.id === id)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const processor = await createResourceMarkdownProcessor(base);
// One line per resource: its purpose without the surrounding paragraph.
const inline = (html: string) => html.trim().replace(/^<p>/, '').replace(/<\/p>$/, '');
const groups = await Promise.all(resourceGroups(section).map(async (group) => ({
  ...group,
  resources: await Promise.all(group.resources.map(async (resource) => ({
    ...resource,
    purpose: inline((await processor.render(summary(schemaFor(resource)))).code),
  }))),
})));
---
<StarlightPage frontmatter={{ title: section.label, description, editUrl: false, tableOfContents: false }}>
  <p>{description}</p>
  <ResourceDiagram section={id} />
  <h2 id="resources">Resources</h2>
  <p>Each reference explains when to declare the resource, what happens if it is omitted, and every field.</p>
  <ul class="catalog">
    {groups.map((group) => <li id={group.apiVersion.replace('/', '-')}>
      <strong>{group.label}</strong> <code>{group.apiVersion}</code>
      <ul>
        {group.resources.map((resource) => <li>
          <a href={`${base}${resource.route}`}><strong>{resource.name}</strong></a>: <Fragment set:html={resource.purpose} />
        </li>)}
      </ul>
    </li>)}
  </ul>
  <slot />
</StarlightPage>

<style>
  .catalog > li + li { margin-top: 1.25rem; }
  .catalog > li > code { margin-inline-start: 0.25rem; }
  .catalog ul { margin-top: 0.5rem; }
  .catalog ul > li + li { margin-top: 0.5rem; }
</style>
