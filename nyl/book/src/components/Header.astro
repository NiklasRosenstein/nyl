---
// Starlight's header with the documentation sections as tabs between the
// site title and the search box. Below the desktop breakpoint the tabs move
// into the menu, which shows the sections above each section's sidebar.
// The current tab is underlined in its layer's color.
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { layerOf } from '../lib/layers.mjs';

const { topics } = Astro.locals.starlightSidebarTopics;
// Pages without a sidebar, such as the landing page, have no menu to hold the
// tabs on narrow screens, so the tabs stay in the header and scroll.
const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <div class="middle sl-flex print:hidden">
    <nav class:list={['sections', { 'no-sidebar': !hasSidebar }]} aria-label="Documentation sections">
      {
        topics.map((topic) => (
          <a
            href={topic.link}
            aria-current={topic.isCurrent ? 'page' : undefined}
            data-tone={layerOf(topic.link)?.tone ?? 'teal'}
          >
            {topic.label}
          </a>
        ))
      }
    </nav>
    <Search />
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  .middle {
    align-items: center;
    gap: 1.5rem;
    height: 100%;
  }

  .sections {
    display: none;
    gap: 1.375rem;
    align-self: stretch;
  }

  /* Every tab has the same box, so the labels share one baseline and the
     current tab's underline sits on the bottom edge of the header. */
  .sections a {
    display: flex;
    align-items: center;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }

  .sections a:hover {
    color: var(--sl-color-white);
  }

  .sections a[aria-current='page'] {
    color: var(--sl-color-white);
    border-bottom-color: var(--nyl-layer-teal);
  }

  .sections a[data-tone='amber'][aria-current='page'] {
    border-bottom-color: var(--nyl-layer-amber);
  }

  .sections a[data-tone='grey'][aria-current='page'] {
    border-bottom-color: var(--nyl-layer-grey);
  }

  @media (max-width: 49.99rem) {
    .sections.no-sidebar {
      display: flex;
      overflow-x: auto;
      max-width: 55vw;
      scrollbar-width: none;
    }
  }

  .right-group,
  .social-icons {
    gap: 1rem;
    align-items: center;
  }

  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  @media (min-width: 50rem) {
    .sections {
      display: flex;
    }

    .header {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-content: center;
    }

    .middle {
      justify-content: space-between;
      padding-inline-start: 2rem;
    }
  }
</style>
