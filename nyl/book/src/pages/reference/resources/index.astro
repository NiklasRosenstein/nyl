---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { createResourceMarkdownProcessor } from '../../../lib/resource-markdown.mjs';
import { resourceGroups, resourceUsage, summary } from '../../../lib/resources.mjs';
import { schemaFor } from '../../../lib/schema-documents';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const processor = await createResourceMarkdownProcessor(base);
const groups = await Promise.all(resourceGroups().map(async (group) => ({
  ...group,
  resources: await Promise.all(group.resources.map(async (resource) => {
    const schema = schemaFor(resource);
    const usage = await Promise.all(resourceUsage(schema).map(async ({ label, markdown }) => ({
      label, html: (await processor.render(markdown)).code,
    })));
    return { ...resource, purpose: (await processor.render(summary(schema))).code, usage };
  })),
})));
---
<StarlightPage frontmatter={{ title: 'Resources', description: 'Nyl resource APIs and their purposes.', editUrl: false }} headings={groups.map((group) => ({ depth: 2, slug: group.apiVersion.replace('/', '-'), text: group.label }))}>
  <p>Choose a resource by its purpose. Each entry explains when to declare the resource and what happens if it is omitted. These conditions concern whole resources; field requirements are documented in each reference.</p>
  {groups.map((group) => <section>
    <h2 id={group.apiVersion.replace('/', '-')}>{group.label}</h2>
    <p><code>{group.apiVersion}</code></p>
    <table><thead><tr><th>Resource</th><th>Purpose and usage</th></tr></thead><tbody>
      {group.resources.map((resource) => <tr>
        <td><a href={`${base}${resource.route}`}>{resource.name}</a></td>
        <td>
          <Fragment set:html={resource.purpose} />
          {resource.usage.map(({ label, html }) => label === 'If omitted'
            ? <details><summary>{label}</summary><Fragment set:html={html} /></details>
            : <div class="usage"><strong>{label}</strong><Fragment set:html={html} /></div>)}
        </td>
      </tr>)}
    </tbody></table>
  </section>)}
  <p>Native Kubernetes, Argo CD, and <a href={`${base}/reference/kyverno-policies/`}>Kyverno policies</a> use their upstream API versions.</p>
</StarlightPage>

<style>
  table { width: 100%; }
  td { vertical-align: top; }
  td p:first-child { margin-top: 0; }
  .usage :global(p) { margin-top: 0.25rem; }
  td details { margin-top: 0.75rem; }
  @media (max-width: 50rem) {
    table, tbody, tr, td { display: block; }
    thead { display: none; }
    tr { padding-block: 1rem; border-bottom: 1px solid var(--sl-color-gray-5); }
    td { padding: 0; border: 0; }
    td:first-child { margin-bottom: 0.75rem; font-weight: 600; font-size: 1.125rem; }
  }
</style>
