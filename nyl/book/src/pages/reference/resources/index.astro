---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { resourceGroups, resourceSections } from '../../../lib/resources.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = resourceSections.map((section) => ({
  ...section,
  names: resourceGroups(section).flatMap((group) => group.resources.map((resource) => resource.name)),
}));
---
<StarlightPage frontmatter={{ title: 'Resources', description: 'Nyl resource APIs by section.', editUrl: false, tableOfContents: false }}>
  <p>Nyl's resources fall into two sections that build on each other, like the documentation.</p>
  <ul>
    {sections.map((section) => <li>
      <a href={`${base}${section.route}`}><strong>{section.label}</strong></a>: {section.names.join(', ')}
    </li>)}
  </ul>
</StarlightPage>
