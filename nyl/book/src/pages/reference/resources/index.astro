---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { resourceGroups, summary } from '../../../lib/resources.mjs';
import { schemaFor } from '../../../lib/schema-documents';
const groups = resourceGroups();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<StarlightPage frontmatter={{ title: 'Resources', description: 'Nyl resource APIs and their purposes.', editUrl: false }} headings={groups.map((group) => ({ depth: 2, slug: group.apiVersion.replace('/', '-'), text: group.label }))}>
  <p>Choose a resource by its purpose. Each reference includes its API version, a useful example, and field definitions.</p>
  {groups.map((group) => <section>
    <h2 id={group.apiVersion.replace('/', '-')}>{group.label}</h2>
    <p><code>{group.apiVersion}</code></p>
    <table><thead><tr><th>Resource</th><th>Purpose</th></tr></thead><tbody>
      {group.resources.map((resource) => <tr><td><a href={`${base}${resource.route}`}>{resource.name}</a></td><td>{summary(schemaFor(resource))}</td></tr>)}
    </tbody></table>
  </section>)}
  <p>Native Kubernetes, Argo CD, and <a href={`${base}/reference/kyverno-policies/`}>Kyverno policies</a> use their upstream API versions.</p>
</StarlightPage>
