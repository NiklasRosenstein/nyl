        {
          "$ref": "#/$defs/DesiredUnit"
        },
        {
          "type": "null"
        }
      ],
      "description": "The desired document the receipt was produced for: a copy written by\nthe same transition that writes the receipt, absent when there is no\nreceipt. A hold reverts an active unit to it directly, never through\ncommit history. Contract: [Recovery](../../../../design/orchestration-core.md#recovery),\n\"Holds on uncertain units\", and [Deletion](../../../../design/orchestration-core.md#deletion),\n\"Holds freeze a unit\"."
    },
    "kind": {
