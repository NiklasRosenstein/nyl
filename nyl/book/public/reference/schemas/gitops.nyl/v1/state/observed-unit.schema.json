        {
          "$ref": "#/$defs/OperatorModification"
        },
        {
          "type": "null"
        }
      ],
      "description": "A native repair requires an explicit approval before the next execution."
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/Receipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
