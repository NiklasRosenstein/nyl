{
  "$defs": {
    "ApplicationDeletionPolicy": {
      "enum": [
        "Foreground",
        "Background",
        "Orphan"
      ],
      "type": "string"
    },
    "CatalogApplicationOverrides": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "applicationDeletionPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApplicationDeletionPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "selfPrunePolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/ManagedResourceDeletionPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "syncPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitOpsSyncPolicy"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "DeploymentTargetSpec": {
      "additionalProperties": false,
      "properties": {
        "applicationGroupSelector": {
          "$ref": "#/$defs/LabelSelector",
          "default": {}
        },
        "argocdRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalogApplication": {
          "$ref": "#/$defs/CatalogApplicationOverrides",
          "default": {
            "enabled": true
          }
        },
        "clusterRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "publication": {
          "$ref": "#/$defs/GitPublication"
        },
        "values": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "publication"
      ],
      "type": "object"
    },
    "GitOpsAutomatedSyncPolicy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "prune": {
          "default": false,
          "type": "boolean"
        },
        "selfHeal": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "GitOpsResourceMetadata": {
      "additionalProperties": false,
      "description": "Metadata shared by local GitOps compiler resources.",
      "properties": {
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "GitOpsSyncPolicy": {
      "additionalProperties": false,
      "properties": {
        "automated": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitOpsAutomatedSyncPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "syncOptions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "GitPublication": {
      "additionalProperties": false,
      "description": "Git coordinates used as a rendered output and Argo CD source.",
      "properties": {
        "pathPrefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/InlineGitRepository"
            },
            {
              "type": "null"
            }
          ]
        },
        "repositoryRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "string"
        }
      },
      "required": [
        "revision"
      ],
      "type": "object"
    },
    "InlineGitRepository": {
      "additionalProperties": false,
      "properties": {
        "publishURL": {
          "type": [
            "string",
            "null"
          ]
        },
        "repoURL": {
          "type": "string"
        }
      },
      "required": [
        "repoURL"
      ],
      "type": "object"
    },
    "LabelSelector": {
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "LocalReference": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ManagedResourceDeletionPolicy": {
      "enum": [
        "Automatic",
        "Confirm",
        "Retain"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A named, independently renderable and publishable deployment slice.",
  "properties": {
    "apiVersion": {
      "const": "gitops.nyl/v1",
      "type": "string"
    },
    "kind": {
      "const": "DeploymentTarget",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/GitOpsResourceMetadata"
    },
    "spec": {
      "$ref": "#/$defs/DeploymentTargetSpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "DeploymentTarget",
  "type": "object"
}
