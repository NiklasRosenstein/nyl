{
  "$defs": {
    "GitOpsResourceMetadata": {
      "additionalProperties": false,
      "description": "Metadata shared by local GitOps compiler resources.",
      "properties": {
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "GitRepositorySpec": {
      "additionalProperties": false,
      "properties": {
        "publishURL": {
          "type": [
            "string",
            "null"
          ]
        },
        "repoURL": {
          "type": "string"
        }
      },
      "required": [
        "repoURL"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A reusable, credential-free Git repository identity.",
  "properties": {
    "apiVersion": {
      "const": "gitops.nyl.niklasrosenstein.github.com/v1",
      "type": "string"
    },
    "kind": {
      "const": "GitRepository",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/GitOpsResourceMetadata"
    },
    "spec": {
      "$ref": "#/$defs/GitRepositorySpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "GitRepository",
  "type": "object"
}
