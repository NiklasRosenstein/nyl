{
  "$defs": {
    "InputSource": {
      "additionalProperties": false,
      "description": "`$fromInput`: a Release input. Its declared default applies when the target\nbinds none. Shorthand: `{$fromInput: name}`.",
      "properties": {
        "name": {
          "description": "Name of an input the Release declares.",
          "type": "string"
        },
        "pointer": {
          "description": "JSON Pointer inside the input's value; the whole value when absent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ObjectMetadata": {
      "additionalProperties": false,
      "description": "Kubernetes object metadata",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations",
          "type": "object"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Labels",
          "type": "object"
        },
        "name": {
          "description": "Resource name",
          "type": "string"
        },
        "namespace": {
          "description": "Namespace (optional)",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ReleaseBundleValueSource": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "Reads an input the Release declares.",
          "properties": {
            "$fromInput": {
              "anyOf": [
                {
                  "description": "Shorthand: the input's name.",
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/InputSource"
                }
              ]
            }
          },
          "required": [
            "$fromInput"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The content, verbatim, even when it looks like a value source.",
          "properties": {
            "$literal": true
          },
          "required": [
            "$literal"
          ],
          "type": "object"
        }
      ],
      "description": "A value source this field accepts instead of a literal. See https://niklasrosenstein.github.io/nyl/reference/value-sources/."
    },
    "RemoteManifestSpec": {
      "additionalProperties": false,
      "description": "RemoteManifest specification",
      "oneOf": [
        {
          "description": "Fetches the manifests at this single URL.",
          "not": {
            "anyOf": [
              {
                "properties": {
                  "urls": {
                    "not": {
                      "type": "null"
                    }
                  }
                },
                "required": [
                  "urls"
                ]
              }
            ]
          },
          "properties": {
            "url": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "url"
          ],
          "title": "url"
        },
        {
          "description": "Fetches the manifests at each URL, in order.",
          "not": {
            "anyOf": [
              {
                "properties": {
                  "url": {
                    "not": {
                      "type": "null"
                    }
                  }
                },
                "required": [
                  "url"
                ]
              }
            ]
          },
          "properties": {
            "urls": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "urls"
          ],
          "title": "urls"
        }
      ],
      "properties": {
        "overrideNamespace": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ReleaseBundleValueSource"
            }
          ],
          "description": "Overwrite fetched manifest metadata.namespace with RemoteManifest metadata.namespace"
        },
        "params": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": [
                "object",
                "null"
              ]
            },
            {
              "$ref": "#/$defs/ReleaseBundleValueSource"
            }
          ],
          "description": "Parameters for `{key}` substitution in `urls` URL templates"
        },
        "url": {
          "anyOf": [
            {
              "type": [
                "string",
                "null"
              ]
            },
            {
              "$ref": "#/$defs/ReleaseBundleValueSource"
            }
          ],
          "description": "Single HTTPS URL to fetch (mutually exclusive with `urls`). In a Release bundle, every\nfield may read a Release input with `{$fromInput: name}`."
        },
        "urls": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            {
              "$ref": "#/$defs/ReleaseBundleValueSource"
            }
          ],
          "description": "List of HTTPS URL templates to fetch (mutually exclusive with `url`)"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Fetches HTTPS YAML or JSON documents and expands them into Kubernetes manifests.\n\nFetched documents enter the recursive render pipeline. Namespace overriding applies when explicitly requested.\n\n## When needed\n\nUse this optional resource to fetch HTTPS YAML or JSON documents into the render pipeline.\n\n## If omitted\n\nNyl does not fetch remote manifests automatically. Other authored resources render normally without a RemoteManifest.",
  "examples": [
    {
      "apiVersion": "k8s.nyl/v1",
      "kind": "RemoteManifest",
      "metadata": {
        "name": "workloads",
        "namespace": "workloads"
      },
      "spec": {
        "url": "https://example.com/manifests/app.yaml"
      }
    }
  ],
  "properties": {
    "apiVersion": {
      "const": "k8s.nyl/v1",
      "description": "API version (must be core Nyl API version)",
      "type": "string"
    },
    "kind": {
      "const": "RemoteManifest",
      "description": "Resource kind (always \"RemoteManifest\")",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ObjectMetadata",
      "description": "Kubernetes metadata"
    },
    "spec": {
      "$ref": "#/$defs/RemoteManifestSpec",
      "description": "Remote manifest source configuration"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "RemoteManifest",
  "type": "object"
}
